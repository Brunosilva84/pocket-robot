#!/bin/zsh
# Creates ~/.pocket-robot/config.json (token, port, workspace) and writes apple/Shared/Config.swift
# (the apps' default hub URL and token) with this Mac's local network name. Safe to run again: keeps the existing token.
set -e
ROOT=${0:A:h:h}
HOME_DIR=$HOME/.pocket-robot
CONFIG=$HOME_DIR/config.json
mkdir -p $HOME_DIR $HOME/pocket-robot-workspace

if [[ ! -f $CONFIG ]]; then
  TOKEN=$(openssl rand -hex 24)
  cat > $CONFIG <<EOF
{
  "token": "$TOKEN",
  "port": 8787,
  "workspace": "$HOME/pocket-robot-workspace",
  "model": "small"
}
EOF
  chmod 600 $CONFIG
  echo "Created $CONFIG"
fi

PORT=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("port", 8787))' $CONFIG)
TOKEN=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' $CONFIG)
# The Mac's Bonjour name keeps working when its IP address changes.
# Set POCKET_ROBOT_HOST=<ip or Tailscale name> if the devices can't resolve .local names.
HOST=${POCKET_ROBOT_HOST:-$(scutil --get LocalHostName).local}

cat > $ROOT/apple/Shared/Config.swift <<EOF
// Generated by scripts/configure. Not committed.
enum Config {
    static let hubURL = "http://$HOST:$PORT"
    static let token = "$TOKEN"
}
EOF
echo "App config: http://$HOST:$PORT (token written to apple/Shared/Config.swift)"
