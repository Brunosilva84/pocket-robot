#!/bin/zsh
# Creates ~/.pocket-robot/config.json (token, port, workspace) and writes the watch's Config.swift
# with this Mac's Wi-Fi address. Safe to run again: keeps the existing token.
set -e
ROOT=${0:A:h:h}
HOME_DIR=$HOME/.pocket-robot
CONFIG=$HOME_DIR/config.json
mkdir -p $HOME_DIR $HOME/pocket-robot-workspace

if [[ ! -f $CONFIG ]]; then
  TOKEN=$(openssl rand -hex 24)
  cat > $CONFIG <<EOF
{
  "token": "$TOKEN",
  "port": 8787,
  "workspace": "$HOME/pocket-robot-workspace",
  "model": "small"
}
EOF
  chmod 600 $CONFIG
  echo "Created $CONFIG"
fi

PORT=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("port", 8787))' $CONFIG)
TOKEN=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' $CONFIG)
IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
if [[ -z $IP ]]; then echo "No Wi-Fi address found. Connect this Mac to Wi-Fi and run again."; exit 1; fi

cat > $ROOT/watch/PocketRobot/Config.swift <<EOF
// Generated by scripts/configure. Not committed.
enum Config {
    static let hubURL = "http://$IP:$PORT"
    static let token = "$TOKEN"
}
EOF
echo "Watch config: http://$IP:$PORT (token written to watch/PocketRobot/Config.swift)"
